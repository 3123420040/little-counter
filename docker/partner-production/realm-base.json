        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "catalog:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "inventory:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "orders:quote",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "orders:write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "orders:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    }
  ],
  "clients": [],
  "bruteForceProtected": true,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false
