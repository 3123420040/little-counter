{
  "extensions": {
    "health_check": {
      "endpoint": "0.0.0.0:13133"
    },
    "file_storage": {
      "directory": "/var/lib/partner/collector/queue",
      "create_directory": true,
      "compaction": {
        "directory": "/var/lib/partner/collector/compaction",
        "on_start": true,
        "on_rebound": true
      }
    }
  },
  "receivers": {
    "otlp": {
      "protocols": {
        "http": {
          "endpoint": "0.0.0.0:4318",
          "max_request_body_size": 1048576
        }
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 128,
      "spike_limit_mib": 32
    },
    "transform/privacy": {
      "error_mode": "propagate",
      "log_statements": [
        {
          "context": "log",
          "statements": [
            "keep_keys(resource.attributes, [\"service.name\", \"service.version\", \"deployment.environment.name\"])",
            "keep_keys(attributes, [\"timestamp\", \"service\", \"environment\", \"release\", \"source\", \"request_id\", \"trace_id\", \"span_id\", \"partner_id\", \"integration_id\", \"client_id\", \"merchant_id\", \"store_id\", \"grant_version\", \"route\", \"method\", \"status\", \"duration_ms\", \"outcome\", \"error_code\", \"idempotency_replayed\", \"client_correlation_id\", \"origin_request_id\", \"event_id\", \"core_order_id\", \"parent_span_id\", \"original_request_id\", \"auth_method\", \"credential_id\", \"key_id\", \"transport\", \"tool_name\"])",
            "truncate_all(attributes, 256)",
            "set(body, \"partner.request\")"
          ]
        }
      ],
      "trace_statements": [
        {
          "context": "span",
          "statements": [
            "keep_keys(resource.attributes, [\"service.name\", \"service.version\", \"deployment.environment.name\"])",
            "keep_keys(attributes, [\"timestamp\", \"service\", \"environment\", \"release\", \"source\", \"request_id\", \"trace_id\", \"span_id\", \"partner_id\", \"integration_id\", \"client_id\", \"merchant_id\", \"store_id\", \"grant_version\", \"route\", \"method\", \"status\", \"duration_ms\", \"outcome\", \"error_code\", \"idempotency_replayed\", \"client_correlation_id\", \"origin_request_id\", \"event_id\", \"core_order_id\", \"parent_span_id\", \"original_request_id\", \"auth_method\", \"credential_id\", \"key_id\", \"transport\", \"tool_name\"])",
            "truncate_all(attributes, 256)",
            "set(name, Concat([attributes[\"method\"], attributes[\"route\"]], \" \"))"
          ]
        }
      ]
    }
  },
  "exporters": {
    "otlphttp/backend": {
      "endpoint": "RENDER_REQUIRED",
      "timeout": "2s",
      "sending_queue": {
        "enabled": true,
        "sizer": "bytes",
        "queue_size": 8388608,
        "num_consumers": 2,
        "storage": "file_storage"
      },
      "retry_on_failure": {
        "enabled": true,
        "initial_interval": "1s",
        "max_interval": "5s",
        "max_elapsed_time": "0s"
      },
      "encoding": "json"
    },
    "otlphttp/observer": {
      "endpoint": "http://partner-observer:58641",
      "encoding": "json",
      "compression": "none",
      "timeout": "2s",
      "sending_queue": {
        "enabled": true,
        "queue_size": 1000,
        "num_consumers": 1,
        "storage": "file_storage"
      },
      "retry_on_failure": {
        "enabled": true,
        "initial_interval": "1s",
        "max_interval": "5s",
        "max_elapsed_time": "0s"
      }
    }
  },
  "service": {
    "extensions": [
      "health_check",
      "file_storage"
    ],
    "telemetry": {
      "logs": {
        "level": "error",
        "encoding": "json"
      },
      "metrics": {
        "readers": [
          {
            "pull": {
              "exporter": {
                "prometheus": {
                  "host": "0.0.0.0",
                  "port": 8888
                }
              }
            }
          }
        ]
      }
    },
    "pipelines": {
      "logs": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "transform/privacy"
        ],
        "exporters": [
          "otlphttp/backend",
          "otlphttp/observer"
        ]
      },
      "traces": {
        "receivers": [
          "otlp"
        ],
        "processors": [
          "memory_limiter",
          "transform/privacy"
        ],
        "exporters": [
          "otlphttp/backend",
          "spanmetrics"
        ]
      },
      "metrics": {
        "receivers": [
          "spanmetrics"
        ],
        "exporters": [
          "otlphttp/backend"
        ]
      }
    }
  },
  "connectors": {
    "spanmetrics": {
      "aggregation_cardinality_limit": 128,
      "metrics_flush_interval": "15s",
      "resource_metrics_key_attributes": [
        "service.name",
        "deployment.environment.name"
      ],
      "histogram": {
        "unit": "ms",
        "explicit": {
          "buckets": [
            "5ms",
            "10ms",
            "50ms",
            "100ms",
            "250ms",
            "500ms",
            "1s",
            "2s",
            "5s"
          ]
        }
      }
    }
  }
}
