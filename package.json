{
  "name": "little-counter",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "overrides": {
    "browserslist": "4.28.9",
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "multer": "2.5.0",
    "shell-quote": "1.11.0",
    "qs": "6.17.1",
    "morgan": "1.12.0",
    "postcss-selector-parser": "6.1.3",
    "@rushstack/node-core-library": {
      "ajv": "8.20.0"
    },
    "@medusajs/core-flows": {
      "csv-parse": "7.0.2"
    },
    "bullmq": {
      "uuid": "11.1.1"
    },
    "proxy-addr": "2.0.8",
    "@graphql-tools/utils": "12.0.2",
    "@grpc/grpc-js": "1.14.5",
    "axios": "1.20.0",
    "compression": "1.8.2",
    "source-map-js": "1.2.2",
    "brace-expansion@1": "1.1.20",
    "brace-expansion@5": "5.0.11",
    "undici@7": "7.30.2",
    "follow-redirects": "1.16.2",
    "body-parser@1": "1.20.9",
    "body-parser@2": "2.4.0",
    "vite@7": "7.3.7"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "dev": "concurrently -n medusa,pos,ai -c blue,magenta,green \"npm run dev:medusa\" \"npm run dev:pos\" \"npm run dev:ai\"",
    "dev:medusa": "medusa develop",
    "dev:pos": "npm run dev -w @medusa-snus/pos",
    "dev:ai": "npm run dev -w @medusa-snus/ai",
    "dev:telegram": "npm run dev -w @medusa-snus/telegram",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "vitest run packages/domain",
    "test:application": "vitest run packages/application",
    "test:ui": "vitest run packages/ui",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "db:migrate": "medusa db:migrate",
    "partner:control": "tsx scripts/partner-control.ts",
    "vision:product-search-sync": "tsx scripts/vision-product-search-sync.ts",
    "start": "sh scripts/start-medusa.sh",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate:custom": "bash scripts/prod-apply-migrations.sh",
    "test:db": "tsx scripts/require-postgres.ts && DATABASE_URL=\"$TEST_DATABASE_URL\" NODE_ENV=test RUNTIME_SCHEMA_DDL_ENABLED=true vitest run --config vitest.db.config.ts",
    "subscription:schedule": "tsx scripts/subscription-lifecycle-scheduler.ts"
  },
  "dependencies": {
    "@medusajs/auth-emailpass": "2.19.0",
    "@medusajs/cli": "2.19.0",
    "@medusajs/core-flows": "2.19.0",
    "@medusajs/framework": "2.19.0",
    "@medusajs/js-sdk": "2.19.0",
    "@medusajs/medusa": "2.19.0",
    "@types/bcrypt": "^6.0.0",
    "@zxing/library": "^0.22.0",
    "ajv": "^8.20.0",
    "bcrypt": "^6.0.0",
    "fastify": "5.12.2",
    "pg": "^8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "4.1.11"
  }
}
